{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pastifico API",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Abrir telas do Pastifico no navegador",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/open-browser-tabs.mjs",
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Pastifico (servidor + 3 abas no navegador)",
      "configurations": ["Pastifico API", "Abrir telas do Pastifico no navegador"],
      "stopAll": true
    }
  ]
}